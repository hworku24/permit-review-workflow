# Copy to .env. Nothing in this file is a real credential.
# A fresh clone runs with these defaults and no external accounts, per NFR-06.

# PermitFlow database
PERMITFLOW_DB_URL=postgresql://permitflow:permitflow@localhost:5433/permitflow

# State licensing replica. Read only account, separate server. See docs/04 section I2.
LICENSING_DB_URL=postgresql://permitflow_ro:readonly@localhost:5434/licensing_replica
LICENSING_DB_TIMEOUT_SECONDS=10

# County property records SOAP service.
# Defaults to the local mock in permitflow/integrations/soap_mock.
PROPERTY_RECORDS_WSDL=http://localhost:8081/property-records?wsdl
PROPERTY_RECORDS_TIMEOUT_SECONDS=10

# Integration resilience, per NFR-03.
INTEGRATION_MAX_ATTEMPTS=3
INTEGRATION_BACKOFF_BASE_SECONDS=1
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_SECONDS=60

# AI provider. Leave AI_PROVIDER=offline to run the deterministic path with no API key,
# which is what CI uses. Set to "anthropic" and supply a key to use a hosted model.
AI_PROVIDER=offline
AI_MODEL=offline-rules-v1
# ANTHROPIC_API_KEY=

# Fields extracted below this confidence are presented blank rather than as a guess (AI-02).
AI_FIELD_CONFIDENCE_THRESHOLD=0.70
# Retrieval below this score is treated as no support, and the answer is withheld (AI-06).
AI_GROUNDING_THRESHOLD=0.35
